---
// Inline line icons (currentColor). Decorative: the visible text or aria-label of the parent names the action.
type Name = "phone" | "viber" | "telegram" | "instagram" | "facebook" | "search" | "menu" | "close" | "arrow" | "pin" | "mail" | "catalog" | "wrench";
interface Props { name: Name; size?: number; class?: string }
const { name, size = 24, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11 11 0 0 0 7.2 7.2l1.4-2.1 4.2 1.6V19a1.6 1.6 0 0 1-1.6 1.6A16.9 16.9 0 0 1 3.4 5.1 1.6 1.6 0 0 1 5 3.5z" />}
  {name === "viber" && (
    <>
      <path d="M12 2.8c5.2 0 8.4 2.4 8.4 7.6s-3.2 7.4-8.4 7.4c-.9 0-1.7-.1-2.5-.2L6 20.6v-3.9C4.3 15.5 3.6 13.4 3.6 10.4 3.6 5.2 6.8 2.8 12 2.8z" />
      <path d="M9.2 7.6c.4-.4 1-.3 1.2.2l.6 1.2c.2.4 0 .8-.3 1.1l-.4.3c.5 1.1 1.3 1.9 2.4 2.4l.3-.4c.3-.3.7-.5 1.1-.3l1.2.6c.5.2.6.8.2 1.2-.6.7-1.4 1-2.3.7-2.2-.8-3.9-2.5-4.7-4.7-.3-.9 0-1.7.7-2.3z" />
    </>
  )}
  {name === "telegram" && <path d="M21 4.2 2.9 11.3c-.8.3-.8 1.4 0 1.6l4.4 1.4 1.7 5.3c.2.7 1.1.9 1.6.4l2.5-2.3 4.6 3.4c.6.4 1.4.1 1.6-.6L22.2 5.4c.2-.8-.5-1.5-1.2-1.2zM7.3 14.3l10.2-6.6-7.7 7.9" />}
  {name === "instagram" && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
      <circle cx="12" cy="12" r="4" />
      <path d="M17.2 6.8h.01" />
    </>
  )}
  {name === "facebook" && <path d="M14.5 21v-7.6h2.6l.4-3h-3v-1.9c0-.9.3-1.5 1.5-1.5h1.6V4.3a21 21 0 0 0-2.3-.1c-2.3 0-3.9 1.4-3.9 4v2.2H8.8v3h2.6V21" />}
  {name === "search" && (
    <>
      <circle cx="11" cy="11" r="6.5" />
      <path d="m16 16 4.5 4.5" />
    </>
  )}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "arrow" && <path d="M5 12h13m-5-5 5 5-5 5" />}
  {name === "pin" && (
    <>
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" />
      <circle cx="12" cy="10" r="2.3" />
    </>
  )}
  {name === "mail" && (
    <>
      <rect x="3" y="5.5" width="18" height="13" rx="2" />
      <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
    </>
  )}
  {name === "wrench" && <path d="M14.7 6.3a4 4 0 0 0 5 5L21 12.6a6 6 0 0 1-7.3 1.2l-6.9 6.9a2.1 2.1 0 0 1-3-3l6.9-6.9A6 6 0 0 1 11.9 3.5l1.3 1.3a4 4 0 0 0 1.5 1.5z" />}
  {name === "catalog" && <path d="M4 5h6v6H4zM14 5h6v6h-6zM4 15h6v4H4zM14 15h6v4h-6z" />}
</svg>

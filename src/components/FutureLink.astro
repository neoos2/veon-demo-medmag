---
// A future page that is not built in the demo yet (menu item, button, card, footer link).
// Renders an inactive element with a short note instead of a link: never point it to the client's current site.
// `note` is written in the project language: «Розділ у розробці».
// `align`: where the note opens (start — from the left edge, end — from the right edge) so it never leaves the screen.
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"span"> { note?: string; class?: string; align?: "start" | "end" }
const { note = "Розділ у розробці", class: cls, align = "start", ...rest } = Astro.props;
---
<span class:list={["future-link", `future-link--${align}`, cls]} role="link" aria-disabled="true" tabindex="0" {...rest}>
  <slot />
  <span class="future-link__note" aria-hidden="true">{note}</span>
  <span class="visually-hidden">({note})</span>
</span>

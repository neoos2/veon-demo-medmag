---
import "@fontsource/unbounded/400.css";
import "@fontsource/unbounded/600.css";
import "@fontsource/wix-madefor-text/400.css";
import "@fontsource/wix-madefor-text/600.css";
import unbounded600 from "@fontsource/unbounded/files/unbounded-cyrillic-600-normal.woff2?url";
import Base from "../layouts/Base.astro";
import "../styles/site.css";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Catalog from "../components/Catalog.astro";
import Consult from "../components/Consult.astro";
import Sale from "../components/Sale.astro";
import Clinics from "../components/Clinics.astro";
import Delivery from "../components/Delivery.astro";
import Service from "../components/Service.astro";
import Contacts from "../components/Contacts.astro";
import Footer from "../components/Footer.astro";
import MobileBar from "../components/MobileBar.astro";
import { phones, contacts } from "../data/site";

const ld = {
  "@context": "https://schema.org",
  "@type": "Store",
  name: "MEDMAG",
  description: "Інтернет-магазин медтехніки з фірмовим магазином у Києві",
  address: { "@type": "PostalAddress", streetAddress: "вул. Левка Лук’яненка, 19", addressLocality: "Київ", postalCode: "04207", addressCountry: "UA" },
  telephone: phones.map((p) => p.href.replace("tel:", "")),
  email: contacts.email,
  openingHoursSpecification: [
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: "09:00", closes: "18:00" },
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Saturday", "Sunday"], opens: "09:00", closes: "16:00" },
  ],
  sameAs: [contacts.facebook, contacts.instagram, contacts.telegram],
};


const title = "Магазин медтехніки в Києві — MEDMAG, доставка по Україні";
const description = "Тонометри, інгалятори, глюкометри, ортопедія і засоби реабілітації: 452 категорії. Фірмовий магазин біля метро Мінська, безкоштовна доставка від 3 000 грн.";
---
<Base lang="uk" title={title} description={description}>
  <Fragment slot="head">
    <link rel="preload" href={unbounded600} as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </Fragment>
  <Header slot="header" />
  <Hero />
  <Catalog />
  <Consult />
  <Sale />
  <Clinics />
  <Delivery />
  <Service />
  <Contacts />
  <Footer slot="footer" />
  <MobileBar slot="footer" />
</Base>
